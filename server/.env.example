# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/ahadu_center

# JWT
JWT_SECRET=your_jwt_secret_here

# Fees (defaults are applied if omitted)
OVERDUE_FEE_PER_DAY=1
RESERVATION_FEE=50

# Email (nodemailer)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass
EMAIL_FROM=AhaduCenter <no-reply@example.com>
CONTACT_EMAIL=admin@example.com

# CORS
CLIENT_ORIGIN=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# Frontend URL used in email verification links
CLIENT_URL=http://localhost:3000

# Google Identity Services
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
